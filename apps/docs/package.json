{
  "name": "@xylex-group/weeping-angel-docs",
  "private": true,
  "version": "0.1.2",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "pnpm run generate:docs && next dev",
    "build": "pnpm run generate:docs && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "generate:cli-reference": "node ./scripts/generate-cli-reference.mjs",
    "generate:docs": "pnpm run generate:cli-reference && node ./scripts/generate-docs.mjs",
    "postinstall": "pnpm run generate:docs && fumadocs-mdx",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "fumadocs-core": "16.7.13",
    "fumadocs-mdx": "14.2.8",
    "fumadocs-ui": "16.7.13",
    "lucide-react": "^0.563.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "wrangler": "^4.124.0"
  }
}
