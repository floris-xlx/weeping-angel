{
  "scope": "repo:acme/app",
  "requests": [
    {
      "path": "/repos/acme/app",
      "status": 200,
      "body": {
        "name": "app",
        "full_name": "acme/app",
        "visibility": "private",
        "default_branch": "develop",
        "archived": false
      }
    },
    {
      "path": "/repos/acme/app/branches/develop/protection",
      "status": 200,
      "body": {
        "required_pull_request_reviews": { "required_approving_review_count": 1 },
        "allow_force_pushes": { "enabled": false },
        "allow_deletions": { "enabled": false },
        "enforce_admins": { "enabled": true }
      }
    },
    {
      "path": "/repos/acme/app/collaborators",
      "status": 200,
      "body": [
        {
          "login": "alice",
          "permissions": { "admin": true, "push": true, "pull": true }
        }
      ]
    },
    {
      "path": "/repos/acme/app/collaborators?affiliation=outside",
      "status": 200,
      "body": [
        {
          "login": "bob",
          "permissions": { "admin": false, "push": true, "pull": true }
        }
      ]
    },
    {
      "path": "/repos/acme/app/keys",
      "status": 200,
      "body": [{ "id": 7, "title": "ci-deploy", "read_only": true }]
    }
  ]
}
